# Neon Postgres (written per branch by the Neon CLI into .env.local)
DATABASE_URL=            # pooled connection, used by the app at runtime
DATABASE_URL_UNPOOLED=   # direct connection, used by Prisma CLI / migrations
NEON_BRANCH=             # e.g. development

# Clerk (development keys start with pk_test_ / sk_test_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
